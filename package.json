{
  "name": "orchid-pagination",
  "type": "module",
  "version": "2.2.0",
  "packageManager": "bun@1.3.14",
  "description": "Orchid ORM query pagination helpers",
  "author": "Ilya Semenov",
  "license": "MIT",
  "homepage": "https://github.com/IlyaSemenov/orchid-pagination#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaSemenov/orchid-pagination"
  },
  "bugs": "https://github.com/IlyaSemenov/orchid-pagination/issues",
  "imports": {
    "#testing": "./testing/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "!src/**/*.test.*",
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint --fix .",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "types": "tsgo"
  },
  "peerDependencies": {
    "@types/node": ">=18",
    "orchid-orm": "^1.68.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@ilyasemenov/eslint-config": "^1.4.2",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "1.3.14",
    "@types/node": "^22.10.1",
    "@typescript/native-preview": "^7.0.0-dev.20260605.1",
    "eslint": "^9.35.0",
    "orchid-orm": "1.68.5",
    "postgres": "^3.4.9",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  }
}
